# AgentLens environment configuration (V1 / Mode A).
# Copy to .env for local development. Secrets must NEVER be committed.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Local run output root (run.json + screenshots/ + artifacts/ are written here).
ARTIFACTS_DIR=.artifacts

# --- Control-plane infrastructure (provisioned via infra/docker-compose.yml) ---
# Not wired into code yet — reserved for Milestone 4 (persistence) onward.
DATABASE_URL=postgresql://agentlens:agentlens@localhost:5432/agentlens
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=agentlens
S3_SECRET_ACCESS_KEY=agentlens
S3_BUCKET=agentlens-artifacts

# --- Execution-plane providers (Milestone 1+) ---
# Sandbox and agent-model credentials are injected into the execution plane only,
# never persisted in plaintext and never placed into the event stream.
# VERCEL_SANDBOX_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
